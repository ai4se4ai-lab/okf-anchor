# OKF Anchor — environment template. Copy to .env and fill in.
# NEVER commit a real .env. NEVER put private keys in PostgreSQL.

# --- Core ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Forces @okf-anchor/logger's (and Next.js's own) ANSI colors on even though stdout
# isn't a real TTY here — true for a Docker container, and equally true under
# `pnpm dev`, since `concurrently` pipes each child's output to prefix it.
FORCE_COLOR=1

# --- PostgreSQL (metadata, versions, provenance, publication history — NOT secrets) ---
# Host port is offset (55432, not 5432) and password is okf_local_dev — see docker-compose.yml.
# Only used when running the app on the host (`pnpm dev`); the containerized app/worker
# get DATABASE_URL injected pointing at postgres:5432 instead, regardless of this value.
DATABASE_URL=postgresql://okf:okf_local_dev@localhost:55432/okf_anchor?schema=public

# --- Redis (cache, queues, rate limiting, idempotency) ---
# Host port is offset (56379, not 6379) — see docker-compose.yml. Same host-only caveat as above.
REDIS_URL=redis://localhost:56379

# --- Auth (server-to-server publishing + user sessions) ---
# openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-long-random-string
# Signing/verification keys for API clients live in a secrets manager, referenced by id.
API_TOKEN_SIGNING_KID=local-dev

# --- Provider selection (see CLAUDE.md §5) ---
STORAGE_PROVIDER=local        # local | ipfs
ANCHOR_PROVIDER=local         # local | evm | origintrail-dkg
GRAPH_PROVIDER=local          # local | sparql-endpoint

# --- IPFS (StorageProvider=ipfs) ---
# The Kubo API/gateway are bound to loopback on offset host ports (55001/58080), not
# 5001/8080 — see docker-compose.yml. Host-only caveat: the containerized app/worker get
# IPFS_API_URL injected as http://ipfs:5001 instead, regardless of this value.
IPFS_API_URL=http://localhost:55001
IPFS_GATEWAY_ALLOWLIST=http://localhost:58080

# --- EVM anchor (ANCHOR_PROVIDER=evm; see docs/evm-anchor.md) ---
# `docker compose up` deploys OKFAnchor automatically (the `contracts` service) —
# no manual step needed.
EVM_RPC_URL=http://localhost:58545
EVM_CHAIN_ID=31337
# Deterministic: OKFAnchor's constructor takes no args and this is the deployer's very
# first tx on a fresh Anvil chain, so `new OKFAnchor()` from this exact key always lands
# at this address (verified locally against ghcr.io/foundry-rs/foundry:v1.0.0). If you
# change EVM_SIGNER_PRIVATE_KEY, redeploy with `pnpm contracts:deploy:anvil` and update
# this to whatever address that run prints.
EVM_ANCHOR_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Dev: Anvil's well-known, publicly documented account #0 — never for real funds.
# Prod: inject the same var from a secrets manager / KMS at deploy time — do NOT commit a real key.
EVM_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EVM_CONFIRMATIONS=1
EVM_REQUEST_TIMEOUT_MS=30000

# --- OriginTrail DKG (ANCHOR_PROVIDER=origintrail-dkg) ---
# Verify the current SDK interface before use — see CLAUDE.md §6.
DKG_NODE_ENDPOINT=
DKG_BLOCKCHAIN=
DKG_PUBLISH_KEY_REF=

# --- SPARQL store (GRAPH_PROVIDER=sparql-endpoint) ---
SPARQL_QUERY_URL=
SPARQL_UPDATE_URL=

# --- Secrets manager (source of truth for all key material) ---
SECRETS_MANAGER=env           # env | vault | aws-kms | gcp-kms
SECRETS_MANAGER_ADDR=
