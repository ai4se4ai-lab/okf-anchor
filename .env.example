# OKF Anchor — environment template. Copy to .env and fill in.
# NEVER commit a real .env. NEVER put private keys in PostgreSQL.

# --- Core ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- PostgreSQL (metadata, versions, provenance, publication history — NOT secrets) ---
DATABASE_URL=postgresql://okf:okf@localhost:5432/okf_anchor?schema=public

# --- Redis (cache, queues, rate limiting, idempotency) ---
REDIS_URL=redis://localhost:6379

# --- Auth (server-to-server publishing + user sessions) ---
# openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-long-random-string
# Signing/verification keys for API clients live in a secrets manager, referenced by id.
API_TOKEN_SIGNING_KID=local-dev

# --- Provider selection (see CLAUDE.md §5) ---
STORAGE_PROVIDER=local        # local | ipfs
ANCHOR_PROVIDER=local         # local | evm | origintrail-dkg
GRAPH_PROVIDER=local          # local | sparql-endpoint

# --- IPFS (StorageProvider=ipfs) ---
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_ALLOWLIST=http://localhost:8080

# --- EVM anchor (ANCHOR_PROVIDER=evm) ---
EVM_RPC_URL=
EVM_CHAIN_ID=
# Signer key is injected from a secrets manager / KMS at runtime — do NOT put it here in prod.
EVM_SIGNER_KEY_REF=

# --- OriginTrail DKG (ANCHOR_PROVIDER=origintrail-dkg) ---
# Verify the current SDK interface before use — see CLAUDE.md §6.
DKG_NODE_ENDPOINT=
DKG_BLOCKCHAIN=
DKG_PUBLISH_KEY_REF=

# --- SPARQL store (GRAPH_PROVIDER=sparql-endpoint) ---
SPARQL_QUERY_URL=
SPARQL_UPDATE_URL=

# --- Secrets manager (source of truth for all key material) ---
SECRETS_MANAGER=env           # env | vault | aws-kms | gcp-kms
SECRETS_MANAGER_ADDR=
