{
  "name": "@okf-anchor/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema and client for OKF Anchor metadata: assets, immutable versions, the five-layer records, publication history, provenance, jobs, and audit. Never stores secrets or knowledge payloads.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "prisma"],
  "scripts": {
    "build": "prisma generate && tsc -b && node scripts/copy-generated.mjs",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.1"
  }
}
