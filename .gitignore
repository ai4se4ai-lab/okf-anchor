# Dependencies
node_modules/
.pnp.*
.yarn/*

# Env / secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Build output
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Generated Prisma client (regenerated by `pnpm --filter @okf-anchor/db generate`)
packages/db/src/generated/

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Prisma
prisma/*.db
prisma/*.db-journal

# Local data volumes
.data/
tmp/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
*.swp
.claude/*